{
  "name": "tiger-task",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node site/build.mjs && vite",
    "build": "node site/build.mjs && tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "npm run build && wrangler deploy",
    "site": "node site/build.mjs",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "worker:dev": "wrangler dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "marked": "^18.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.167.0"
  }
}
